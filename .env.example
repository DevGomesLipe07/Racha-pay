# RachaPay — copie para .env e ajuste. Os segredos abaixo são de DESENVOLVIMENTO:
# o servidor recusa subir com eles quando NODE_ENV=production.

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Papel SEM superuser/BYPASSRLS (criado por scripts/db-init.sql). Em produção: ?sslmode=require
DATABASE_URL=postgresql://rachapay_app:rachapay_dev@localhost:5432/rachapay
# Banco descartável dos testes de integração — o teste APAGA e recria o schema.
TEST_DATABASE_URL=postgresql://rachapay_app:rachapay_dev@localhost:5432/rachapay_test

# openssl rand -base64 32
APP_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZXMta2V5LWZvci1yYWNoYXA=
# openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token-change-me-0000000000000000

# Sandbox de pagamento (só teste). Em produção com PSP real: SANDBOX_ENABLED=false
SANDBOX_ENABLED=true
SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret-change-me

# true atrás de load balancer (lê X-Forwarded-For/Proto)
TRUST_PROXY=false

# IA opcional (leitura de cupom por foto). Sem chave, o sistema funciona igual.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

LOG_LEVEL=info
