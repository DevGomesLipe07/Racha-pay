{
  "name": "rachapay",
  "version": "0.1.0",
  "private": true,
  "description": "RachaPay — divisão, cobrança, pagamento e conciliação de despesas compartilhadas.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "migrate": "node scripts/migrate.ts",
    "tenant:create": "node scripts/create-tenant.ts",
    "backup": "node scripts/backup.ts",
    "backup:verify": "node scripts/verify-backup.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "playwright": "1.64.1",
    "qrcode-generator": "2.0.4",
    "typescript": "7.0.2"
  }
}
